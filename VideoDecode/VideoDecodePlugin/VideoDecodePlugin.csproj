<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VideoDecodePlugin</AssemblyName>
    <RootNamespace>VideoDecode</RootNamespace>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <PathMap>$(RepoRoot)=.</PathMap>
  </PropertyGroup>

  <!-- Referenced assemblies are loaded by the host (YMM4) at run time, so they are not copied to the output; public APIs only -->
  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Plugin"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker.Plugin.FileSource.FFmpeg"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.FileSource.FFmpeg.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker.Interop.FFmpeg"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Interop.FFmpeg.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FFmpeg.AutoGen"><HintPath>$(YMM4DirPath)FFmpeg.AutoGen.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpGen.Runtime"><HintPath>$(YMM4DirPath)SharpGen.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpGen.Runtime.COM"><HintPath>$(YMM4DirPath)SharpGen.Runtime.COM.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Direct2D1"><HintPath>$(YMM4DirPath)Vortice.Direct2D1.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Direct3D11"><HintPath>$(YMM4DirPath)Vortice.Direct3D11.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.DirectX"><HintPath>$(YMM4DirPath)Vortice.DirectX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.DXGI"><HintPath>$(YMM4DirPath)Vortice.DXGI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>$(YMM4DirPath)Vortice.Mathematics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Opt-in: copies the DLL to <dir> only when -p:DeployDir=<dir> is given -->
  <Target Name="DeployToDir" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFolder="$(DeployDir)" />
  </Target>

</Project>
